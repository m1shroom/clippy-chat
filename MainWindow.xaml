<Window x:Class="ClippyWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clippy Chat" Height="640" Width="500" MinWidth="350" MinHeight="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" WindowStartupLocation="Manual" Left="400" Top="200"
        MouseDown="Window_MouseDown" Loaded="Window_Loaded"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="ModernScrollThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Chrome" CornerRadius="3" Background="#40ffffff" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#66ffffff"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#88ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollThumbStyle}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollThumbStyle}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GlowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="Transparent" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect x:Name="GlowEffect" BlurRadius="12" Color="White" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="Opacity" From="0" To="0.8" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#25ffffff" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="Transparent" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlowSendButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="#aa2b5278" CornerRadius="19" BorderBrush="#20ffffff" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect x:Name="GlowEffect" BlurRadius="15" Color="White" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="Opacity" From="0" To="0.9" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#cc3b6690" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#aa2b5278" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="ChatWindow" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Background="#01000000" MouseDown="ChatWindow_MouseDown" PreviewMouseWheel="ChatWindow_PreviewMouseWheel" Margin="0,0,10,10">
            <Border CornerRadius="24" Background="#f01a1a1c" BorderBrush="#25ffffff" BorderThickness="1.2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Direction="315" ShadowDepth="3" Opacity="0.4" Color="Black"/>
                </Border.Effect>
            </Border>

            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,5,0,0">
                    <Grid Margin="0,0,0,12">
                        <Button HorizontalAlignment="Left" VerticalAlignment="Center" Width="24" Height="24" Click="ClearBtn_Click" Cursor="Hand" Style="{StaticResource GlowControlButtonStyle}">
                            <Path Data="M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19M8,9H16V19H8V9M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z" Fill="#cccccc" Stretch="Uniform" Width="14" Height="14"/>
                        </Button>

                        <TextBlock Text="ИИ помощник Clippy" Foreground="#dddddd" FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="24" Height="24" Click="CloseBtn_Click" Cursor="Hand" Style="{StaticResource GlowControlButtonStyle}">
                            <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Fill="#cccccc" Stretch="Uniform" Width="12" Height="12"/>
                        </Button>
                    </Grid>
                    <Border Height="1" Background="#20ffffff" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <ListBox x:Name="ChatBubbleList" Grid.Row="1" Background="Transparent" BorderThickness="0" 
         Foreground="White" Margin="0,0,5,0" Padding="0,0,5,0" 
         ScrollViewer.VerticalScrollBarVisibility="Auto"
         ScrollViewer.HorizontalScrollBarVisibility="Auto"
         HorizontalContentAlignment="Stretch" VirtualizingPanel.ScrollUnit="Pixel">
    
    <ListBox.OpacityMask>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="Transparent" Offset="0.0"/>
            <GradientStop Color="White" Offset="0.005"/> <GradientStop Color="White" Offset="0.995"/> <GradientStop Color="Transparent" Offset="1.0"/>
        </LinearGradientBrush>
    </ListBox.OpacityMask>
    
    <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
                            <EventSetter Event="MouseDoubleClick" Handler="ListBoxItem_MouseDoubleClick"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="BubbleBorder" CornerRadius="16" Background="#cd28282a" BorderBrush="#15ffffff" BorderThickness="1" Padding="14,10" Margin="0,5" MaxWidth="380" HorizontalAlignment="Left" Opacity="0" Cursor="Hand">
                                            <Border.Effect>
                                                <DropShadowEffect x:Name="BubbleGlow" BlurRadius="8" Direction="315" ShadowDepth="2" Opacity="0.4" Color="Black"/>
                                            </Border.Effect>
                                            <StackPanel IsHitTestVisible="False">
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="White" FontSize="13" FontFamily="Segoe UI" Visibility="{Binding TextVisibility}"/>
                                                <Border CornerRadius="10" Margin="0,5,0,0" Visibility="{Binding ImageVisibility}">
                                                    <Image Source="{Binding ImagePath}" MaxWidth="230" MaxHeight="180" Stretch="Uniform"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="BubbleBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="BubbleGlow" Storyboard.TargetProperty="Color" To="White" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="BubbleGlow" Storyboard.TargetProperty="BlurRadius" To="14" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="BubbleGlow" Storyboard.TargetProperty="ShadowDepth" To="0" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="BubbleGlow" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="BubbleGlow" Storyboard.TargetProperty="Color" To="Black" Duration="0:0:0.2"/>
                                                            <DoubleAnimation Storyboard.TargetName="BubbleGlow" Storyboard.TargetProperty="BlurRadius" To="8" Duration="0:0:0.2"/>
                                                            <DoubleAnimation Storyboard.TargetName="BubbleGlow" Storyboard.TargetProperty="ShadowDepth" To="2" Duration="0:0:0.2"/>
                                                            <DoubleAnimation Storyboard.TargetName="BubbleGlow" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter TargetName="BubbleBorder" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="BubbleBorder" Property="Background" Value="#cd254b70"/>
                                                <Setter TargetName="BubbleBorder" Property="BorderBrush" Value="#25ffffff"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,0,0,0">
                    <Border Height="1" Background="#20ffffff" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" x:Name="InputContainer" CornerRadius="20" Background="#99111111" BorderBrush="#20ffffff" BorderThickness="1" Padding="12,5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#66ffffff"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <TextBlock Text="Введите запрос..." Foreground="#66ffffff" FontSize="13" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=EntryField}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="EntryField" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="13" FontFamily="Segoe UI" PreviewKeyDown="Entry_PreviewKeyDown" VerticalAlignment="Center" DataObject.Pasting="EntryField_Pasting"/>
                            </Grid>
                        </Border>

                        <Button Grid.Column="1" Width="38" Height="38" Margin="8,0,0,0" Click="AttachBtn_Click" Cursor="Hand" Style="{StaticResource GlowControlButtonStyle}">
                            <Path Data="M16.5,6V17.5A4,4 0 0,1 12.5,21.5A4,4 0 0,1 8.5,17.5V5A2.5,2.5 0 0,1 11,2.5A2.5,2.5 0 0,1 13.5,5V15.5A1,1 0 0,1 12.5,16.5A1,1 0 0,1 11.5,15.5V6H10V15.5A2.5,2.5 0 0,0 12.5,18A2.5,2.5 0 0,0 15,15.5V5A4,4 0 0,0 11,1A4,4 0 0,0 7,5V17.5A5.5,5.5 0 0,0 12.5,23A5.5,5.5 0 0,0 18,17.5V6H16.5Z" Fill="#cccccc" Stretch="Uniform" Width="16" Height="16"/>
                        </Button>

                        <Button Grid.Column="2" Width="38" Height="38" Margin="8,0,0,0" Click="SendBtn_Click" Cursor="Hand" Style="{StaticResource GlowSendButtonStyle}">
                            <Path Data="M2,21L23,12L2,3V10L17,12L2,14V21Z" Fill="White" Stretch="Uniform" Width="15" Height="15" Margin="2,0,0,0"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <Canvas Grid.Column="1" Grid.Row="1" Width="85" Height="85" Margin="5,5,15,15" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Image x:Name="ClippyCharacter" Source="pack://application:,,,/clippy.png" 
                   Height="75" Width="75" Canvas.Left="0" Canvas.Top="0" Stretch="Uniform" 
                   Cursor="Hand" 
                   MouseLeftButtonDown="ClippyCharacter_MouseLeftButtonDown"
                   MouseRightButtonDown="ClippyCharacter_MouseRightButtonDown"/>
        </Canvas>
    </Grid>
</Window>